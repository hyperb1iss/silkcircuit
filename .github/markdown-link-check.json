{
  "ignorePatterns": [
    { "pattern": "^https?://localhost" },
    { "pattern": "^https?://127\\.0\\.0\\.1" },
    { "pattern": "^https?://(www\\.)?example\\.(com|org)" },
    { "pattern": "^https://ko-fi\\.com" }
  ],
  "replacements": [{ "pattern": "^/", "replacement": "{{BASEURL}}/" }],
  "httpHeaders": [
    {
      "urls": ["https://github.com", "https://marketplace.visualstudio.com"],
      "headers": {
        "Accept": "text/html",
        "User-Agent": "Mozilla/5.0 (compatible; markdown-link-check)"
      }
    }
  ],
  "timeout": "30s",
  "retryOn429": true,
  "retryCount": 5,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 301, 302, 303, 307, 308]
}
