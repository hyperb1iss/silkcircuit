# SilkCircuit Glow for Git
# https://github.com/hyperb1iss/silkcircuit
#
# Generated by scripts/build from lua/silkcircuit/variants.lua.
# Do not edit by hand.

[color]
	ui = auto

[color "branch"]
	current = "#ff00ff bold"
	local = "#00ffff"
	remote = "#ff66ff"
	upstream = "#0099ff"
	plain = "#ffffff"

[color "decorate"]
	branch = "#ff00ff bold"
	remoteBranch = "#ff66ff"
	tag = "#ffff00 bold"
	stash = "#00ffff"
	HEAD = "#ff00ff bold"
	grafted = "#ff0066"

[color "diff"]
	meta = "#ff00ff bold"
	frag = "#ff66ff bold"
	func = "#00ffff"
	context = "#cc66ff"
	old = "#ff0066"
	new = "#00ff00"
	commit = "#ffff00"
	whitespace = "#ff0066 reverse"

[color "status"]
	header = "#cc66ff"
	added = "#00ff00 bold"
	changed = "#00ffff bold"
	untracked = "#00ffff bold"
	deleted = "#ff0066 bold"
	branch = "#ffff00 bold"
	nobranch = "#ff0066 bold"
	unmerged = "#ff0066 bold"
	localBranch = "#ff00ff"
	remoteBranch = "#ff66ff"

[color "interactive"]
	prompt = "#ff00ff bold"
	header = "#ff66ff"
	help = "#00ffff"
	error = "#ff0066"

[color "grep"]
	context = "#cc66ff"
	filename = "#ff00ff bold"
	function = "#00ffff"
	linenumber = "#ff66ff"
	column = "#cc66ff"
	match = "#ffff00 bold"
	selected = "#cc66ff"
	separator = "#00ffff"

[pretty]
	silkcircuit = "%C(#ff00ff bold)commit %H%Creset%C(#ffff00)%d%Creset%n%C(#ffffff)Author: %C(#ff66ff)%an <%ae>%Creset%n%C(#ffffff)Date:   %C(#00ffff)%ad%Creset%n%n%C(#ffffff)    %s%Creset%n%n%w(0,4,4)%C(#ffffff)%b%Creset"

[delta "silkcircuit-glow"]
	dark = true
	navigate = true
	line-numbers = true
	side-by-side = false
	syntax-theme = "SilkCircuit Glow"
	file-style = "#ffff00 bold"
	file-decoration-style = "#ffff00 ul"
	hunk-header-style = "file line-number syntax"
	hunk-header-decoration-style = "#00ffff box"
	hunk-header-file-style = "#00ffff bold"
	hunk-header-line-number-style = "#ff66ff"
	commit-style = "#ff00ff bold"
	commit-decoration-style = "#ff00ff box ul"
	line-numbers-left-style = "#cc66ff"
	line-numbers-right-style = "#cc66ff"
	line-numbers-zero-style = "#cc66ff"
	line-numbers-minus-style = "#ff0066 bold"
	line-numbers-plus-style = "#00ff00 bold"
	minus-style = "syntax auto"
	minus-emph-style = "syntax auto bold"
	plus-style = "syntax auto"
	plus-emph-style = "syntax auto bold"
	zero-style = "syntax"
	whitespace-error-style = "#ff0066 reverse"
	blame-palette = "#0a0816 #1a0033 #2b0735 #4b0654"

# The delta feature above only takes effect once you ask for it. Uncomment
# whichever of these you want, in this file or in your own config:
#
# [core]
# 	pager = delta
# [interactive]
# 	diffFilter = delta --color-only
# [delta]
# 	features = silkcircuit-glow
#
# The log format is named rather than default, so reach for it with
# `git log --pretty=silkcircuit`, or make it the default with:
#
# [format]
# 	pretty = silkcircuit
