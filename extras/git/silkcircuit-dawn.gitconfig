# SilkCircuit Dawn for Git
# https://github.com/hyperb1iss/silkcircuit
#
# Generated by scripts/build from lua/silkcircuit/variants.lua.
# Do not edit by hand.

[color]
	ui = auto

[color "branch"]
	current = "#7e2bd5 bold"
	local = "#006e72"
	remote = "#b02f7a"
	upstream = "#1454dc"
	plain = "#2b2540"

[color "decorate"]
	branch = "#7e2bd5 bold"
	remoteBranch = "#b02f7a"
	tag = "#796100 bold"
	stash = "#006e72"
	HEAD = "#b40077 bold"
	grafted = "#c1272d"

[color "diff"]
	meta = "#7e2bd5 bold"
	frag = "#b02f7a bold"
	func = "#006e72"
	context = "#5a4d6e"
	old = "#c1272d"
	new = "#1d6e46"
	commit = "#796100"
	whitespace = "#c1272d reverse"

[color "status"]
	header = "#5a4d6e"
	added = "#1d6e46 bold"
	changed = "#1454dc bold"
	untracked = "#006e72 bold"
	deleted = "#c1272d bold"
	branch = "#796100 bold"
	nobranch = "#c1272d bold"
	unmerged = "#c1272d bold"
	localBranch = "#7e2bd5"
	remoteBranch = "#b02f7a"

[color "interactive"]
	prompt = "#7e2bd5 bold"
	header = "#b02f7a"
	help = "#006e72"
	error = "#c1272d"

[color "grep"]
	context = "#5a4d6e"
	filename = "#7e2bd5 bold"
	function = "#006e72"
	linenumber = "#b02f7a"
	column = "#7353a9"
	match = "#796100 bold"
	selected = "#5a4d6e"
	separator = "#006e72"

[pretty]
	silkcircuit = "%C(#7e2bd5 bold)commit %H%Creset%C(#796100)%d%Creset%n%C(#2b2540)Author: %C(#b02f7a)%an <%ae>%Creset%n%C(#2b2540)Date:   %C(#006e72)%ad%Creset%n%n%C(#1d6e46)    %s%Creset%n%n%w(0,4,4)%C(#5a4d6e)%b%Creset"

[delta "silkcircuit-dawn"]
	light = true
	navigate = true
	line-numbers = true
	side-by-side = false
	syntax-theme = "silkcircuit-dawn"
	file-style = "#796100 bold"
	file-decoration-style = "#796100 ul"
	hunk-header-style = "file line-number syntax"
	hunk-header-decoration-style = "#006e72 box"
	hunk-header-file-style = "#006e72 bold"
	hunk-header-line-number-style = "#b02f7a"
	commit-style = "#7e2bd5 bold"
	commit-decoration-style = "#7e2bd5 box ul"
	line-numbers-left-style = "#7353a9"
	line-numbers-right-style = "#7353a9"
	line-numbers-zero-style = "#877aa6"
	line-numbers-minus-style = "#c1272d bold"
	line-numbers-plus-style = "#1d6e46 bold"
	minus-style = "syntax auto"
	minus-emph-style = "syntax auto bold"
	plus-style = "syntax auto"
	plus-emph-style = "syntax auto bold"
	zero-style = "syntax"
	whitespace-error-style = "#c1272d reverse"
	blame-palette = "#faf8ff #f7f4ff #e6def7 #d4c8f0"

# The delta feature above only takes effect once you ask for it. Uncomment
# whichever of these you want, in this file or in your own config:
#
# [core]
# 	pager = delta
# [interactive]
# 	diffFilter = delta --color-only
# [delta]
# 	features = silkcircuit-dawn
#
# The log format is named rather than default, so reach for it with
# `git log --pretty=silkcircuit`, or make it the default with:
#
# [format]
# 	pretty = silkcircuit
