# SilkCircuit Dawn for Git
# https://github.com/hyperb1iss/silkcircuit
#
# Generated by scripts/build from lua/silkcircuit/variants.lua.
# Do not edit by hand.

[color]
	ui = auto

[color "branch"]
	current = "#7e2bd5 bold"
	local = "#007f8e"
	remote = "#c04a8f"
	upstream = "#2563eb"
	plain = "#2b2540"

[color "decorate"]
	branch = "#7e2bd5 bold"
	remoteBranch = "#c04a8f"
	tag = "#a88600 bold"
	stash = "#007f8e"
	HEAD = "#b40077 bold"
	grafted = "#c1272d"

[color "diff"]
	meta = "#7e2bd5 bold"
	frag = "#c04a8f bold"
	func = "#007f8e"
	context = "#5a4d6e"
	old = "#c1272d"
	new = "#2d8659"
	commit = "#a88600"
	whitespace = "#c1272d reverse"

[color "status"]
	header = "#5a4d6e"
	added = "#2d8659 bold"
	changed = "#2563eb bold"
	untracked = "#007f8e bold"
	deleted = "#c1272d bold"
	branch = "#a88600 bold"
	nobranch = "#c1272d bold"
	unmerged = "#c1272d bold"
	localBranch = "#7e2bd5"
	remoteBranch = "#c04a8f"

[color "interactive"]
	prompt = "#7e2bd5 bold"
	header = "#c04a8f"
	help = "#007f8e"
	error = "#c1272d"

[color "grep"]
	context = "#5a4d6e"
	filename = "#7e2bd5 bold"
	function = "#007f8e"
	linenumber = "#c04a8f"
	column = "#8e84a8"
	match = "#a88600 bold"
	selected = "#5a4d6e"
	separator = "#007f8e"

[pretty]
	silkcircuit = "%C(#7e2bd5 bold)commit %H%Creset%C(#a88600)%d%Creset%n%C(#2b2540)Author: %C(#c04a8f)%an <%ae>%Creset%n%C(#2b2540)Date:   %C(#007f8e)%ad%Creset%n%n%C(#2b2540)    %s%Creset%n%n%w(0,4,4)%C(#2b2540)%b%Creset"

[delta "silkcircuit-dawn"]
	light = true
	navigate = true
	line-numbers = true
	side-by-side = false
	syntax-theme = "silkcircuit-dawn"
	file-style = "#a88600 bold"
	file-decoration-style = "#a88600 ul"
	hunk-header-style = "file line-number syntax"
	hunk-header-decoration-style = "#007f8e box"
	hunk-header-file-style = "#007f8e bold"
	hunk-header-line-number-style = "#c04a8f"
	commit-style = "#7e2bd5 bold"
	commit-decoration-style = "#7e2bd5 box ul"
	line-numbers-left-style = "#8e84a8"
	line-numbers-right-style = "#8e84a8"
	line-numbers-zero-style = "#8e84a8"
	line-numbers-minus-style = "#c1272d bold"
	line-numbers-plus-style = "#2d8659 bold"
	minus-style = "syntax auto"
	minus-emph-style = "syntax auto bold"
	plus-style = "syntax auto"
	plus-emph-style = "syntax auto bold"
	zero-style = "syntax"
	whitespace-error-style = "#c1272d reverse"
	blame-palette = "#faf8ff #e8e0ff #e6def7 #d4c8f0"

# The delta feature above only takes effect once you ask for it. Uncomment
# whichever of these you want, in this file or in your own config:
#
# [core]
# 	pager = delta
# [interactive]
# 	diffFilter = delta --color-only
# [delta]
# 	features = silkcircuit-dawn
#
# The log format is named rather than default, so reach for it with
# `git log --pretty=silkcircuit`, or make it the default with:
#
# [format]
# 	pretty = silkcircuit
