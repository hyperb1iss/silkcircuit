# SilkCircuit Soft for Git
# https://github.com/hyperb1iss/silkcircuit
#
# Generated by scripts/build from lua/silkcircuit/variants.lua.
# Do not edit by hand.

[color]
	ui = auto

[color "branch"]
	current = "#e892ff bold"
	local = "#99ffee"
	remote = "#ffb3ff"
	upstream = "#92aaff"
	plain = "#f8f8f2"

[color "decorate"]
	branch = "#e892ff bold"
	remoteBranch = "#ffb3ff"
	tag = "#ffe699 bold"
	stash = "#99ffee"
	HEAD = "#ff99ff bold"
	grafted = "#ff6677"

[color "diff"]
	meta = "#e892ff bold"
	frag = "#ffb3ff bold"
	func = "#99ffee"
	context = "#e9d5ff"
	old = "#ff5874"
	new = "#addb67"
	commit = "#ffe699"
	whitespace = "#ff6677 reverse"

[color "status"]
	header = "#e9d5ff"
	added = "#addb67 bold"
	changed = "#82aaff bold"
	untracked = "#99ffee bold"
	deleted = "#ff5874 bold"
	branch = "#ffe699 bold"
	nobranch = "#ff6677 bold"
	unmerged = "#ff6677 bold"
	localBranch = "#e892ff"
	remoteBranch = "#ffb3ff"

[color "interactive"]
	prompt = "#e892ff bold"
	header = "#ffb3ff"
	help = "#99ffee"
	error = "#ff6677"

[color "grep"]
	context = "#e9d5ff"
	filename = "#e892ff bold"
	function = "#99ffee"
	linenumber = "#ffb3ff"
	column = "#b199ff"
	match = "#ffe699 bold"
	selected = "#e9d5ff"
	separator = "#99ffee"

[pretty]
	silkcircuit = "%C(#e892ff bold)commit %H%Creset%C(#ffe699)%d%Creset%n%C(#f8f8f2)Author: %C(#ffb3ff)%an <%ae>%Creset%n%C(#f8f8f2)Date:   %C(#99ffee)%ad%Creset%n%n%C(#66ff99)    %s%Creset%n%n%w(0,4,4)%C(#e9d5ff)%b%Creset"

[delta "silkcircuit-soft"]
	dark = true
	navigate = true
	line-numbers = true
	side-by-side = false
	syntax-theme = "silkcircuit-soft"
	file-style = "#ffe699 bold"
	file-decoration-style = "#ffe699 ul"
	hunk-header-style = "file line-number syntax"
	hunk-header-decoration-style = "#99ffee box"
	hunk-header-file-style = "#99ffee bold"
	hunk-header-line-number-style = "#ffb3ff"
	commit-style = "#e892ff bold"
	commit-decoration-style = "#e892ff box ul"
	line-numbers-left-style = "#b199ff"
	line-numbers-right-style = "#b199ff"
	line-numbers-zero-style = "#6272a4"
	line-numbers-minus-style = "#ff5874 bold"
	line-numbers-plus-style = "#addb67 bold"
	minus-style = "syntax auto"
	minus-emph-style = "syntax auto bold"
	plus-style = "syntax auto"
	plus-emph-style = "syntax auto bold"
	zero-style = "syntax"
	whitespace-error-style = "#ff6677 reverse"
	blame-palette = "#1a1626 #201b30 #2b2a3b #44475a"

# The delta feature above only takes effect once you ask for it. Uncomment
# whichever of these you want, in this file or in your own config:
#
# [core]
# 	pager = delta
# [interactive]
# 	diffFilter = delta --color-only
# [delta]
# 	features = silkcircuit-soft
#
# The log format is named rather than default, so reach for it with
# `git log --pretty=silkcircuit`, or make it the default with:
#
# [format]
# 	pretty = silkcircuit
