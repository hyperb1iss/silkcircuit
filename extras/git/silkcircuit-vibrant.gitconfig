# SilkCircuit Vibrant for Git
# https://github.com/hyperb1iss/silkcircuit
#
# Generated by scripts/build from lua/silkcircuit/variants.lua.
# Do not edit by hand.

[color]
	ui = auto

[color "branch"]
	current = "#ff00ff bold"
	local = "#00ffcc"
	remote = "#ff66ff"
	upstream = "#6699ff"
	plain = "#f8f8f2"

[color "decorate"]
	branch = "#ff00ff bold"
	remoteBranch = "#ff66ff"
	tag = "#ffcc00 bold"
	stash = "#00ffcc"
	HEAD = "#ff00cc bold"
	grafted = "#ff3366"

[color "diff"]
	meta = "#ff00ff bold"
	frag = "#ff66ff bold"
	func = "#00ffcc"
	context = "#e9d5ff"
	old = "#ff5874"
	new = "#addb67"
	commit = "#ffcc00"
	whitespace = "#ff3366 reverse"

[color "status"]
	header = "#e9d5ff"
	added = "#addb67 bold"
	changed = "#82aaff bold"
	untracked = "#00ffcc bold"
	deleted = "#ff5874 bold"
	branch = "#ffcc00 bold"
	nobranch = "#ff3366 bold"
	unmerged = "#ff3366 bold"
	localBranch = "#ff00ff"
	remoteBranch = "#ff66ff"

[color "interactive"]
	prompt = "#ff00ff bold"
	header = "#ff66ff"
	help = "#00ffcc"
	error = "#ff3366"

[color "grep"]
	context = "#e9d5ff"
	filename = "#ff00ff bold"
	function = "#00ffcc"
	linenumber = "#ff66ff"
	column = "#b366ff"
	match = "#ffcc00 bold"
	selected = "#e9d5ff"
	separator = "#00ffcc"

[pretty]
	silkcircuit = "%C(#ff00ff bold)commit %H%Creset%C(#ffcc00)%d%Creset%n%C(#f8f8f2)Author: %C(#ff66ff)%an <%ae>%Creset%n%C(#f8f8f2)Date:   %C(#00ffcc)%ad%Creset%n%n%C(#f8f8f2)    %s%Creset%n%n%w(0,4,4)%C(#f8f8f2)%b%Creset"

[delta "silkcircuit-vibrant"]
	dark = true
	navigate = true
	line-numbers = true
	side-by-side = false
	syntax-theme = "silkcircuit-vibrant"
	file-style = "#ffcc00 bold"
	file-decoration-style = "#ffcc00 ul"
	hunk-header-style = "file line-number syntax"
	hunk-header-decoration-style = "#00ffcc box"
	hunk-header-file-style = "#00ffcc bold"
	hunk-header-line-number-style = "#ff66ff"
	commit-style = "#ff00ff bold"
	commit-decoration-style = "#ff00ff box ul"
	line-numbers-left-style = "#b366ff"
	line-numbers-right-style = "#b366ff"
	line-numbers-zero-style = "#6272a4"
	line-numbers-minus-style = "#ff5874 bold"
	line-numbers-plus-style = "#addb67 bold"
	minus-style = "syntax auto"
	minus-emph-style = "syntax auto bold"
	plus-style = "syntax auto"
	plus-emph-style = "syntax auto bold"
	zero-style = "syntax"
	whitespace-error-style = "#ff3366 reverse"
	blame-palette = "#0f0c1a #151026 #201a34 #3a2e5a"

# The delta feature above only takes effect once you ask for it. Uncomment
# whichever of these you want, in this file or in your own config:
#
# [core]
# 	pager = delta
# [interactive]
# 	diffFilter = delta --color-only
# [delta]
# 	features = silkcircuit-vibrant
#
# The log format is named rather than default, so reach for it with
# `git log --pretty=silkcircuit`, or make it the default with:
#
# [format]
# 	pretty = silkcircuit
