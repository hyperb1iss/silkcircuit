# SilkCircuit Neon for Git
# https://github.com/hyperb1iss/silkcircuit
#
# Generated by scripts/build from lua/silkcircuit/variants.lua.
# Do not edit by hand.

[color]
	ui = auto

[color "branch"]
	current = "#e135ff bold"
	local = "#80ffea"
	remote = "#ff69ff"
	upstream = "#82aaff"
	plain = "#f8f8f2"

[color "decorate"]
	branch = "#e135ff bold"
	remoteBranch = "#ff69ff"
	tag = "#f1fa8c bold"
	stash = "#80ffea"
	HEAD = "#ff00ff bold"
	grafted = "#ff6363"

[color "diff"]
	meta = "#e135ff bold"
	frag = "#ff69ff bold"
	func = "#80ffea"
	context = "#e9d5ff"
	old = "#ff5874"
	new = "#addb67"
	commit = "#f1fa8c"
	whitespace = "#ff6363 reverse"

[color "status"]
	header = "#e9d5ff"
	added = "#addb67 bold"
	changed = "#82aaff bold"
	untracked = "#80ffea bold"
	deleted = "#ff5874 bold"
	branch = "#f1fa8c bold"
	nobranch = "#ff6363 bold"
	unmerged = "#ff6363 bold"
	localBranch = "#e135ff"
	remoteBranch = "#ff69ff"

[color "interactive"]
	prompt = "#e135ff bold"
	header = "#ff69ff"
	help = "#80ffea"
	error = "#ff6363"

[color "grep"]
	context = "#e9d5ff"
	filename = "#e135ff bold"
	function = "#80ffea"
	linenumber = "#ff69ff"
	column = "#9580ff"
	match = "#f1fa8c bold"
	selected = "#e9d5ff"
	separator = "#80ffea"

[pretty]
	silkcircuit = "%C(#e135ff bold)commit %H%Creset%C(#f1fa8c)%d%Creset%n%C(#f8f8f2)Author: %C(#ff69ff)%an <%ae>%Creset%n%C(#f8f8f2)Date:   %C(#80ffea)%ad%Creset%n%n%C(#f8f8f2)    %s%Creset%n%n%w(0,4,4)%C(#f8f8f2)%b%Creset"

[delta "silkcircuit-neon"]
	dark = true
	navigate = true
	line-numbers = true
	side-by-side = false
	syntax-theme = "silkcircuit-neon"
	file-style = "#f1fa8c bold"
	file-decoration-style = "#f1fa8c ul"
	hunk-header-style = "file line-number syntax"
	hunk-header-decoration-style = "#80ffea box"
	hunk-header-file-style = "#80ffea bold"
	hunk-header-line-number-style = "#ff69ff"
	commit-style = "#e135ff bold"
	commit-decoration-style = "#e135ff box ul"
	line-numbers-left-style = "#9580ff"
	line-numbers-right-style = "#9580ff"
	line-numbers-zero-style = "#6272a4"
	line-numbers-minus-style = "#ff5874 bold"
	line-numbers-plus-style = "#addb67 bold"
	minus-style = "syntax auto"
	minus-emph-style = "syntax auto bold"
	plus-style = "syntax auto"
	plus-emph-style = "syntax auto bold"
	zero-style = "syntax"
	whitespace-error-style = "#ff6363 reverse"
	blame-palette = "#12101a #1a162a #262634 #44475a"

# The delta feature above only takes effect once you ask for it. Uncomment
# whichever of these you want, in this file or in your own config:
#
# [core]
# 	pager = delta
# [interactive]
# 	diffFilter = delta --color-only
# [delta]
# 	features = silkcircuit-neon
#
# The log format is named rather than default, so reach for it with
# `git log --pretty=silkcircuit`, or make it the default with:
#
# [format]
# 	pretty = silkcircuit
